# BEQ Configuration Template
# Copy this file to .env and fill in your paths

# Equivalence Checking Level
# Options: basic, normal, advanced, all
BEQ_LEVEL=basic

# Benchmark Dataset
# Options: o1-generated, rautoformalizer-generated, proofnet, connf
EQ_BENCHMARK=o1-generated

# LLM Model Configuration
EQUIV_MODEL=kimina_72b
EQUIV_URL=http://localhost:13420/v1

# Paths Configuration
# IMPORTANT: Update these paths to match your system
MATHLIB_ROOT=/path/to/mathlib4
REPL_ROOT=/path/to/repl
DATASET_ROOT=./data/
WORKING_ROOT=./results/

# Execution Parameters
TRY_NUM=16
NUM_CONCURRENCY=1
TEMPERATURE=0.0

# vLLM Options
TRUST_REMOTE_CODE=true
ENABLE_PREFIX_CACHING=true

# GPU Configuration (optional)
CUDA_VISIBLE_DEVICES=0

# Lean Configuration
REPL_TIMEOUT=120
INIT_WAIT_TIME=2

# Logging
LOG_LEVEL=INFO
